namespace TES3MP.Protocol.Schema.MagicUseCommand;

enum MagicUseSourceKind : ubyte {
  Spell = 0,
  EnchantedItem = 1,
}

enum MagicUseTargetKind : ubyte {
  Self = 0,
  Player = 1,
  Actor = 2,
}

table ClientCommandHeader {
  session_id:ulong (id: 0);
  session_generation:ulong (id: 1);
  command_sequence:ulong (id: 2);
  command_id:ulong (id: 3);
  observed_canonical_revision:ulong (id: 4);
}

table ClientMagicUseCommand {
  header:ClientCommandHeader (id: 0);
  source_kind:MagicUseSourceKind (id: 1);
  source_id:ulong (id: 2);
  target_kind:MagicUseTargetKind (id: 3);
  target_id:ulong (id: 4);
  source_server_tick:ulong (id: 5);
  expected_caster_revision:ulong (id: 6);
  expected_target_revision:ulong (id: 7);
  expected_inventory_revision:ulong (id: 8);
}

root_type ClientMagicUseCommand;
file_identifier "T3MU";
file_extension "t3mu";
