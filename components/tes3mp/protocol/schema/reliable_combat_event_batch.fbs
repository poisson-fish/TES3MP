namespace TES3MP.Protocol.Schema.CombatEvent;

enum MeleeDamageStat : ubyte {
  Health = 0,
  Fatigue = 1,
}

enum MagicUseSourceKind : ubyte {
  Spell = 0,
  EnchantedItem = 1,
}

enum MagicUseTargetKind : ubyte {
  Self = 0,
  Player = 1,
  Actor = 2,
}

table CombatEventHeader {
  target_session_id:ulong (id: 0);
  target_session_generation:ulong (id: 1);
  server_tick:ulong (id: 2);
  canonical_revision:ulong (id: 3);
}

struct MeleeCombatEvent {
  attacker_player_id:ulong;
  target_actor_id:ulong;
  attacker_combat_revision:ulong;
  target_combat_revision:ulong;
  damage:float;
  damage_stat:MeleeDamageStat;
  hit:bool;
  blocked:bool;
  target_died:bool;
}

struct ActorMeleeCombatEvent {
  attacker_actor_id:ulong;
  target_player_id:ulong;
  attacker_combat_revision:ulong;
  target_combat_revision:ulong;
  damage:float;
  damage_stat:MeleeDamageStat;
  hit:bool;
  blocked:bool;
  target_died:bool;
}

struct MagicUseCombatEvent {
  caster_player_id:ulong;
  source_id:ulong;
  target_id:ulong;
  caster_combat_revision:ulong;
  target_combat_revision:ulong;
  self_health_delta:float;
  self_fatigue_delta:float;
  self_magicka_delta:float;
  target_health_delta:float;
  target_fatigue_delta:float;
  target_magicka_delta:float;
  source_kind:MagicUseSourceKind;
  target_kind:MagicUseTargetKind;
  cast_succeeded:bool;
  target_died:bool;
}

enum MagicEffectCombatEventKind : ubyte {
  Started = 0,
  Updated = 1,
  Ended = 2,
}

enum MagicEffectCombatEndReason : ubyte {
  None = 0,
  Expired = 1,
  Dispelled = 2,
  Replaced = 3,
  TargetDied = 4,
}

struct MagicEffectCombatEvent {
  instance_id:ulong;
  target_id:ulong;
  start_tick:ulong;
  end_tick:ulong;
  target_combat_revision:ulong;
  magnitude_per_second:float;
  applied_delta:float;
  event_kind:MagicEffectCombatEventKind;
  end_reason:MagicEffectCombatEndReason;
  target_kind:MagicUseTargetKind;
  effect_kind:ubyte;
}

table ReliableCombatEventBatch {
  header:CombatEventHeader (id: 0);
  events:[MeleeCombatEvent] (id: 1);
  actor_events:[ActorMeleeCombatEvent] (id: 2);
  magic_events:[MagicUseCombatEvent] (id: 3);
  magic_effect_events:[MagicEffectCombatEvent] (id: 4);
}

root_type ReliableCombatEventBatch;
file_identifier "T3CE";
file_extension "t3ce";
