namespace TES3MP.Protocol.Schema.CombatSnapshot;

table CombatSnapshotHeader {
  target_session_id:ulong (id: 0);
  target_session_generation:ulong (id: 1);
  server_tick:ulong (id: 2);
  canonical_revision:ulong (id: 3);
  self_player_id:ulong (id: 4);
  self_combat_revision:ulong (id: 5);
  self_fatigue:float (id: 6);
  self_health:float = 0 (id: 7);
  self_dead:bool = false (id: 8);
  self_maximum_health:float = 0 (id: 9);
  self_maximum_fatigue:float = 0 (id: 10);
  self_magicka:float = 0 (id: 11);
  self_maximum_magicka:float = 0 (id: 12);
}

struct ActorCombatSnapshot {
  actor_id:ulong;
  combat_revision:ulong;
  health:float;
  maximum_health:float;
  fatigue:float;
  maximum_fatigue:float;
  dead:bool;
}

struct CombatSkillSnapshot {
  skill:ubyte;
  value:float;
  progress:float;
}

table LatestWinsCombatSnapshot {
  header:CombatSnapshotHeader (id: 0);
  actors:[ActorCombatSnapshot] (id: 1);
  self_skills:[CombatSkillSnapshot] (id: 2);
}

root_type LatestWinsCombatSnapshot;
file_identifier "T3CS";
file_extension "t3cs";
