namespace TES3MP.Protocol.Schema.CombatSnapshot;

table CombatSnapshotHeader {
  target_session_id:ulong (id: 0);
  target_session_generation:ulong (id: 1);
  server_tick:ulong (id: 2);
  canonical_revision:ulong (id: 3);
  self_player_id:ulong (id: 4);
  self_combat_revision:ulong (id: 5);
  self_fatigue:float (id: 6);
  self_health:float = 0 (id: 7);
  self_dead:bool = false (id: 8);
  self_maximum_health:float = 0 (id: 9);
  self_maximum_fatigue:float = 0 (id: 10);
  self_magicka:float = 0 (id: 11);
  self_maximum_magicka:float = 0 (id: 12);
  self_knockout_state:ubyte (id: 13);
  self_knockout_frame:ushort (id: 14);
  self_paralyzed:bool (id: 15);
}

struct ActorCombatSnapshot {
  actor_id:ulong;
  combat_revision:ulong;
  health:float;
  maximum_health:float;
  fatigue:float;
  maximum_fatigue:float;
  magicka:float;
  maximum_magicka:float;
  dead:bool;
  cast_id:ulong;
  cast_phase:ubyte;
  cast_range:ubyte;
  cast_elapsed:ushort;
  cast_release:ushort;
  cast_stop:ushort;
  knockout_state:ubyte;
  knockout_frame:ushort;
  paralyzed:bool;
}

struct PlayerCombatSnapshot {
  player_id:ulong;
  combat_revision:ulong;
  health:float;
  maximum_health:float;
  fatigue:float;
  maximum_fatigue:float;
  magicka:float;
  maximum_magicka:float;
  dead:bool;
  knockout_state:ubyte;
  knockout_frame:ushort;
  paralyzed:bool;
}

struct CombatSkillSnapshot {
  skill:ubyte;
  value:float;
  progress:float;
}

enum MagicUseSourceKind : ubyte {
  Spell = 0,
  EnchantedItem = 1,
}

enum MagicUseTargetKind : ubyte {
  Self = 0,
  Player = 1,
  Actor = 2,
}

struct ActiveMagicEffectSnapshot {
  instance_id:ulong;
  caster_player_id:ulong;
  source_id:ulong;
  target_id:ulong;
  start_tick:ulong;
  end_tick:ulong;
  magnitude_per_second:float;
  source_kind:MagicUseSourceKind;
  target_kind:MagicUseTargetKind;
  effect_kind:ubyte;
}

table PlayerSwingSnapshot {
  player_id:ulong;
  command:ulong;
  source:ulong;
  target_life:ulong;
  direction:ubyte;
  phase:ubyte;
  interruption:ubyte;
  strength:float;
  completion:float;
  group:string;
}

table ActorPresentationSnapshot {
  id:ulong;
  life:ulong = 1;
  action:ulong;
  body_action:ulong;
  kind:ubyte;
  phase:ubyte;
  direction:ubyte;
  body_state:ubyte = 1;
  hit_group:ubyte;
  strength:float;
  completion:float;
  rate:float;
  body_frame:float;
  body_stop:ushort;
  loop_start:ushort;
  loop_stop:ushort;
  group:string;
  dead:bool;
  cast:ulong;
  cast_phase:ubyte;
  cast_range:ubyte;
  cast_elapsed:ushort;
  cast_release:ushort;
  cast_stop:ushort;
  visibility:[float];
}

table LatestWinsCombatSnapshot {
  header:CombatSnapshotHeader (id: 0);
  actors:[ActorCombatSnapshot] (id: 1);
  self_skills:[CombatSkillSnapshot] (id: 2);
  players:[PlayerCombatSnapshot] (id: 3);
  active_effects:[ActiveMagicEffectSnapshot] (id: 4);
  swings:[PlayerSwingSnapshot] (id: 5);
  presentation:[ActorPresentationSnapshot] (id: 6);
}

root_type LatestWinsCombatSnapshot;
file_identifier "T3C9";
file_extension "t3cs";
