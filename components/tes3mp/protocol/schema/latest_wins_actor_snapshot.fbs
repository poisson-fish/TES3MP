namespace TES3MP.Protocol.Schema.ActorSnapshot;

table ActorSnapshotHeader {
  target_session_id:ulong (id: 0);
  target_session_generation:ulong (id: 1);
  server_tick:ulong (id: 2);
  canonical_revision:ulong (id: 3);
}

enum CellKind : ubyte {
  Unknown = 0,
  Interior = 1,
  Exterior = 2
}

enum ActorActivity : ubyte {
  Unknown = 0,
  Idle = 1,
  Travel = 2,
  Wander = 3
}

struct Cell { cell_space_id:ulong; grid_x:int; grid_y:int; kind:CellKind; }
struct Position3 { x:long; y:long; z:long; }
struct Orientation3 { x:uint; y:uint; z:uint; }
struct LinearVelocity3 { x:long; y:long; z:long; }

struct ActorSpatialSnapshot {
  actor_id:ulong;
  entity_id:ulong;
  prototype_id:ulong;
  entity_revision:ulong;
  authority_epoch:ulong;
  server_tick:ulong;
  cell:Cell;
  position:Position3;
  orientation:Orientation3;
  linear_velocity:LinearVelocity3;
  activity:ActorActivity;
}

table ActorWorldView { entries:[ActorSpatialSnapshot] (id: 0); }

table LatestWinsActorSnapshot {
  header:ActorSnapshotHeader (id: 0);
  view:ActorWorldView (id: 1);
}

root_type LatestWinsActorSnapshot;
file_identifier "T3AS";
file_extension "t3as";
