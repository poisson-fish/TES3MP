namespace TES3MP.Protocol.Schema.GroundItemBaseline;

struct Position3 {
  x:long;
  y:long;
  z:long;
}

enum CellKind : ubyte {
  Unknown = 0,
  Interior = 1,
  Exterior = 2
}

struct Cell {
  cell_space_id:ulong;
  grid_x:int;
  grid_y:int;
  kind:CellKind;
  padding0:ubyte;
  padding1:ushort;
  padding2:uint;
}

struct GroundItem {
  stack_id:ulong;
  prototype_id:ulong;
  count:uint;
  condition:uint;
  enchantment_charge:uint;
  soul_prototype_id:ulong;
  has_soul:ubyte;
  padding0:ubyte;
  padding1:ushort;
  x:long;
  y:long;
  z:long;
  revision:ulong;
}

table GroundItemBaselineHeader {
  target_session_id:ulong (id: 0);
  target_session_generation:ulong (id: 1);
  server_tick:ulong (id: 2);
  canonical_revision:ulong (id: 3);
  chunk_index:uint (id: 4);
  chunk_count:uint (id: 5);
}

table ReliableGroundItemBaseline {
  header:GroundItemBaselineHeader (id: 0);
  cell:Cell (id: 1);
  items:[GroundItem] (id: 2);
}

root_type ReliableGroundItemBaseline;
file_identifier "T3GI";
file_extension "t3gi";
