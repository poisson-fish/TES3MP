namespace TES3MP.Protocol.Schema.EquipmentSnapshot;

struct EquipmentMember {
  player_id:ulong;
  helmet:ulong;
  cuirass:ulong;
  greaves:ulong;
  left_pauldron:ulong;
  right_pauldron:ulong;
  left_gauntlet:ulong;
  right_gauntlet:ulong;
  boots:ulong;
  shirt:ulong;
  pants:ulong;
  skirt:ulong;
  robe:ulong;
  left_ring:ulong;
  right_ring:ulong;
  amulet:ulong;
  belt:ulong;
  carried_right:ulong;
  carried_left:ulong;
  ammunition:ulong;
}

table EquipmentSnapshotHeader {
  target_session_id:ulong (id: 0);
  target_session_generation:ulong (id: 1);
  server_tick:ulong (id: 2);
  canonical_revision:ulong (id: 3);
}

table LatestWinsEquipmentSnapshot {
  header:EquipmentSnapshotHeader (id: 0);
  members:[EquipmentMember] (id: 1);
}

root_type LatestWinsEquipmentSnapshot;
file_identifier "T3EQ";
file_extension "t3eq";
