namespace TES3MP.Protocol.Schema.Reliable;

table ClientCommandHeader {
  session_id:ulong (id: 0);
  session_generation:ulong (id: 1);
  command_sequence:ulong (id: 2);
  command_id:ulong (id: 3);
  observed_canonical_revision:ulong (id: 4);
}

table EntityPrecondition {
  entity_id:ulong (id: 0);
  expected_revision:ulong (id: 1);
  expected_authority_epoch:ulong (id: 2);
}

struct LinearVelocity3 {
  x:long;
  y:long;
  z:long;
}

table PlayerMotionIntent {
  desired_velocity:LinearVelocity3 (id: 0);
}

enum LocomotionMode : ubyte {
  Unknown = 0,
  Sneak = 1,
  Walk = 2,
  Run = 3,
  Jump = 4
}

table PlayerLocomotionInput {
  input_tick:ulong (id: 0);
  input_sequence:ulong (id: 1);
  locomotion_mode:LocomotionMode (id: 2);
  root_facing:uint (id: 3);
  desired_velocity:LinearVelocity3 (id: 4);
}

enum CellKind : ubyte {
  Unknown = 0,
  Interior = 1,
  Exterior = 2
}

struct Cell {
  cell_space_id:ulong;
  grid_x:int;
  grid_y:int;
  kind:CellKind;
}

table CellTransition {
  requested_cell:Cell (id: 0);
}

union ReliableOperationBody {
  PlayerMotionIntent = 1,
  CellTransition = 2,
  PlayerLocomotionInput = 3
}

table ReliableOperation {
  command_header:ClientCommandHeader (id: 0);
  entity_precondition:EntityPrecondition (id: 1);
  body:ReliableOperationBody (id: 3);
}

root_type ReliableOperation;
file_identifier "T3RO";
file_extension "t3ro";
