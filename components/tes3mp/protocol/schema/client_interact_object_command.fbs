namespace TES3MP.Protocol.Schema.InteractObject;

struct Position3 {
  x:long;
  y:long;
  z:long;
}

enum CellKind : ubyte {
  Unknown = 0,
  Interior = 1,
  Exterior = 2
}

struct Cell {
  cell_space_id:ulong;
  grid_x:int;
  grid_y:int;
  kind:CellKind;
}

enum ObjectInteractionKind : ubyte {
  Activate = 0,
  UnlockWithKey = 1
}

table ClientCommandHeader {
  session_id:ulong (id: 0);
  session_generation:ulong (id: 1);
  command_sequence:ulong (id: 2);
  command_id:ulong (id: 3);
  observed_canonical_revision:ulong (id: 4);
}

table ClientInteractObjectCommand {
  header:ClientCommandHeader (id: 0);
  object_id:ulong (id: 1);
  target_cell:Cell (id: 2);
  interaction_origin:Position3 (id: 3);
  expected_revision:ulong (id: 4);
  kind:ObjectInteractionKind (id: 5);
  has_requested_key:bool (id: 6);
  requested_key_id:ulong (id: 7);
}

root_type ClientInteractObjectCommand;
file_identifier "T3IC";
file_extension "t3ic";
