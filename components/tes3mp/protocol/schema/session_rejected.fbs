namespace TES3MP.Protocol.Schema;

enum SessionRejectionReason : ubyte {
  Unknown = 0,
  ProtocolMajorMismatch = 1,
  NoCompatibleMinor = 2,
  UnsupportedRequiredCapability = 3
}

table SessionRejected {
  reason:SessionRejectionReason = Unknown (id: 0);
  server_protocol_major:ushort (id: 1);
  server_minimum_minor:ushort (id: 2);
  server_maximum_minor:ushort (id: 3);
  unsupported_capability:uint = 0 (id: 4);
}

root_type SessionRejected;
file_identifier "T3RJ";
file_extension "t3rj";
